<?xml version="1.0" encoding="utf-8"?>

<!--
    Cross-job underlying-event estimate for simulation samples: one job per
    ptHat bin, each running run_ue_bin.sh on that bin's file pairs
    ({{WORKDIR}}/bin_${JOBINDEX}.list), copied to the job's scratch first.
    Filled in by submit_ue_by_pthat.sh (see its -h):
      {{WORKDIR}}       folder holding the per-bin lists and log/
      {{UE_ARGS}}       options passed on to UnderlyingEvent (e.g. "0 minbias")
      {{MIN_STORAGE}}   scratch space to request, MB (largest bin x 2.5 + 1 GB:
                        the inputs, the rewritten copies, and the build)
      {{STDOUT_URL}}/{{STDERR_URL}}  per-job log destination (-k flag)
    star-submit must run from the pipeline root, since the SandBox <File>
    paths below are relative to it.
-->

<job nProcesses="1">

    <ResourceUsage>
        <StorageSpace>
            <MinStorage>{{MIN_STORAGE}}</MinStorage>
        </StorageSpace>
    </ResourceUsage>

    <shell>singularity exec -e -B /direct -B /star -B /afs -B /gpfs -B /sdcc/lustre02 /cvmfs/star.sdcc.bnl.gov/containers/rhic_sl7.sif</shell>

    <command>
        stardev
        module purge
        module load root-5.34.38

        cp underlying_event/* .
        cp shared/* .
        g++ -m64 -O2 UnderlyingEvent.cpp VectorDict.cxx -o UnderlyingEvent `root-config --cflags --libs` -std=c++11

        echo "pairs list: {{WORKDIR}}/bin_${JOBINDEX}.list"
        date
        bash run_ue_bin.sh {{WORKDIR}}/bin_${JOBINDEX}.list {{UE_ARGS}}
        date
    </command>

    <SandBox installer="ZIP">
        <Package>
            <File>file:./underlying_event</File>
            <File>file:./shared/JetParameters.h</File>
            <File>file:./shared/VectorDict.cxx</File>
            <File>file:./shared/VectorDict.h</File>
            <File>file:./shared/VectorDictClass.h</File>
            <File>file:./shared/VectorDictLinkDef.h</File>
        </Package>
    </SandBox>

    <stdout URL="{{STDOUT_URL}}"/>
    <stderr URL="{{STDERR_URL}}"/>

</job>
