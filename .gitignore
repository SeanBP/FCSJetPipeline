# StRoot build cache (rebuild with stardev/cons)
.sl73_x8664_gcc485/
.sl73_gcc485/
.al96_x8664_gcc11/
.consign
*.o
*.so
*.d
*.pcm
__pycache__/
*.pyc

# Scheduler files: written to the root by star-submit, moved to submit/ when done
/sched*
submit/

# Per-submission XMLs generated by the submit_*.sh wrappers from the templates
/sim_to_jet/sim_to_jet_*.xml
/data_to_jet/data_to_jet_*.xml
/jet_scale/jet_scale_*.xml
!/jet_scale/jet_scale_em_only.xml
/jet_scale/jet_scale_em_only_*.xml
/jet_calibration/jet_calibration_*.xml
!/jet_calibration/jet_calibration_em_only.xml
/jet_calibration/jet_calibration_em_only_*.xml
/pico_analysis/pico_analysis_*.xml

# Default scratch output and log folders (root only: FCS2VIRTUE/output/ is tracked)
/output/
log/

# Compiled programs (build lines are at the top of each source)
/FCS2VIRTUE/FCS2VIRTUE
/GeometryPlayground/fiducial_from_corners
/UnfoldingPlayground/fms_multiplicity_unfold
/UnfoldingPlayground/fms_response
/UnfoldingPlayground/fms_unfold_stat_scan

# Study outputs (regenerable)
/*Playground/**/*.root
/*Playground/**/*.pdf
/*Playground/**/*.png

# Editor/OS cruft
*~
.DS_Store
/UnderlyingEventPlayground/energy_flow/cal_chain_compare

# Per-submission XMLs and input lists of the playground studies (templates stay)
/UnderlyingEventPlayground/in_event/in_event_*.xml
/ANPlayground/an_job_*.xml
/ANPlayground/benchmark_*.list
/ANPlayground/jes/

# Compiled programs and build products of the in-event UE, recoil and pi0 studies
/UnderlyingEventPlayground/in_event/*
!/UnderlyingEventPlayground/in_event/*.cpp
!/UnderlyingEventPlayground/in_event/*.h
!/UnderlyingEventPlayground/in_event/in_event.xml
!/UnderlyingEventPlayground/in_event/submit_in_event.sh
/UnderlyingEventPlayground/recoil_truth/*
!/UnderlyingEventPlayground/recoil_truth/*.cpp
!/UnderlyingEventPlayground/recoil_truth/*.csh
!/UnderlyingEventPlayground/recoil_truth/*.sh
!/UnderlyingEventPlayground/recoil_truth/*.sub
!/UnderlyingEventPlayground/recoil_truth/chk.C
!/UnderlyingEventPlayground/recoil_truth/recoil_jobs.txt
/Pi0Playground/hot_tower_scan
/Pi0Playground/pi0_calib_compare
/Pi0Playground/pi0_compare
/Pi0Playground/pi0_overlap_study
/Pi0Playground/pi0_pairs
/Pi0Playground/pi0_scale_plots
/Pi0Playground/pi0_trigger_study
/Pi0Playground/pi0_vs_pdg
/Pi0Playground/pi0_pairs_*.xml
/Pi0Playground/minimal/
/Pi0Playground/trigemu/*
!/Pi0Playground/trigemu/*.cpp
!/Pi0Playground/trigemu/*.C
!/Pi0Playground/trigemu/stage_params.txt
*.log
